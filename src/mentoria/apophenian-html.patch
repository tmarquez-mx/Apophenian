+      }
+      let cuerpo;
+      try{ cuerpo = await r.text(); }
+      catch(e){
+        throw control.signal.aborted
+          ? fallo('tiempo', 'El ' + NOMBRE + ' dejó de responder a mitad de la respuesta. No se muestra texto parcial.')
